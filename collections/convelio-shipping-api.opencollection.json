{
  "opencollection": "1.0.0",
  "info": {
    "name": "Convelio Public Shipping API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "shipping",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Shipment estimation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.convelio.com/v2/shipping/estimate/price",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              },
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "Currency to use for the response. Accepted currencies are EUR, USD and GBP."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Use this endpoint to obtain a first estimation for a shipment."
        },
        {
          "info": {
            "name": "Request a quote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.convelio.com/v2/shipping/quote",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              },
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "Currency to use for the response. Accepted currencies are EUR, USD and GBP."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get a quote from Convelio. An operations representative will get in contact with you if necessary."
        },
        {
          "info": {
            "name": "Get quote",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.convelio.com/v2/shipping/quote/:quoteId",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              },
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path",
                "description": "Quote ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a quote by its ID."
        },
        {
          "info": {
            "name": "Create an Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.convelio.com/v2/shipping/order",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              },
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "Currency to use for the response. Accepted currencies are EUR, USD and GBP."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an order for given Quote ID."
        }
      ]
    }
  ],
  "bundled": true
}